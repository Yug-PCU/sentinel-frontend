# Copy this file to .env.local (git-ignored) and edit it.
# Restart `npm run dev` after changing any value.

# "true" shows built-in mock results. Set to "false" once the backend is running
# to send real requests to POST /analyze.
VITE_USE_MOCK_API=true

# Backend origin used by the browser, e.g. https://api.example.com.
# Leave empty to call /analyze on the frontend's own origin; in development the
# Vite dev server forwards those requests to API_PROXY_TARGET.
VITE_API_BASE_URL=

# Milliseconds to wait for the backend before showing a timeout error.
VITE_REQUEST_TIMEOUT_MS=30000

# Dev and preview servers only: where to forward /analyze requests.
API_PROXY_TARGET=http://localhost:8000
